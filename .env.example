# Identidade visual
NEXT_PUBLIC_NOME_APLICACAO="Recicla Belô"
NEXT_PUBLIC_DESCRICAO_APLICACAO="Gestão que transforma"
NEXT_PUBLIC_ICONE_APLICACAO="/favicon.svg"
NEXT_PUBLIC_FAVICON="/favicon.svg"
NEXT_PUBLIC_COR_PRIMARIA="#167347"
NEXT_PUBLIC_COR_PRIMARIA_ESCURA="#075c37"
NEXT_PUBLIC_COR_FUNDO="#f5f7f6"
NEXT_PUBLIC_URL_API="http://localhost:3333"

# Aplicação e segurança
AMBIENTE="desenvolvimento"
CONFIAR_PROXY="false"
PORTA_FRONTEND="3000"
PORTA_API="3333"
ORIGEM_FRONTEND="http://localhost:3000"
SEGREDO_JWT="__GERAR_SEGREDO_JWT__"
EXPIRACAO_SESSAO="8h"
LIMITE_ARQUIVO_MB="8"
PASTA_ARQUIVOS="servidor/arquivos"

# PostgreSQL 18.6
BANCO_HOST="localhost"
BANCO_PORTA="55432"
BANCO_NOME="reciclabelo"
BANCO_USUARIO="reciclabelo"
BANCO_SENHA="__GERAR_SENHA_BANCO__"
BANCO_SSL="false"
URL_BANCO="__GERAR_URL_BANCO__"

# Administrador único — altere em produção
ADMIN_EMAIL="admin@reciclabelo"
ADMIN_SENHA="__GERAR_SENHA_ADMIN__"
ADMIN_NOME="Administrador"
